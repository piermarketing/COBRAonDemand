# --- Core ---------------------------------------------------------------
# Postgres (Cloud SQL). Leave unset locally to use the embedded PGlite database in .data/.
# DATABASE_URL=postgres://cod_app:password@127.0.0.1:5432/cobra
# DB_AUTO_MIGRATE=false

# 32 random bytes, base64. Encrypts SSN, DOB and EIN. Required in production (Secret Manager / KMS).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEY=

# Signs session cookies and consent links. Required in production.
# SESSION_SECRET=

# Bearer token Cloud Scheduler sends to POST /api/jobs/{name}.
# CRON_SECRET=

# --- URLs ---------------------------------------------------------------
# APP_ROOT_DOMAIN=cobraondemand.com
# APP_BASE_URL=http://localhost:3000
# ENROLLEE_SUBDOMAINS=false        # true → links use {company}.cobraondemand.com

# --- Administrator details shown on notices -----------------------------
# ADMINISTRATOR_NAME="COBRA on Demand"
# ADMINISTRATOR_ADDRESS="PO Box 0000|Long Beach, CA 90802"
# ADMINISTRATOR_PHONE="(800) 555-0199"
# ADMINISTRATOR_EMAIL=help@cobraondemand.com
# CA_ADMINISTRATOR_CERTIFICATE=

# --- Billing --------------------------------------------------------------
# MANUAL_ADMIN_FEE_CENTS=2500       # paper administration fee per participant (amount to be set)
# STRIPE_SECRET_KEY=                # not wired yet: dev records test tokens

# --- Providers (BAA required before any PHI is sent) ----------------------
# POSTMARK_TOKEN= / SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=
# LOB_API_KEY=
# FINCH_CLIENT_ID= / FINCH_CLIENT_SECRET= / FINCH_WEBHOOK_SECRET=

# --- Storage --------------------------------------------------------------
# DATA_DIR=.data                    # local PGlite + documents
# DOCUMENT_STORAGE=local            # gcs in Cloud Run
# DOCUMENT_BUCKET=                  # required with gcs

# --- Development only -----------------------------------------------------
# COD_TODAY=2026-12-01              # move the clock to exercise deadlines and jobs (ignored in production)
# LOG_MESSAGES=true
